-- Bottom Action Controls
local function makeActionBtn(text, xPos, width, isPrimary, callback)
	local idleCol = isPrimary and PALETTE.Accent or PALETTE.BtnIdle
	local hoverCol = isPrimary and PALETTE.AccentHover or PALETTE.BtnHover
	local pressCol = isPrimary and PALETTE.AccentPress or PALETTE.BtnPress

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, width, 0, 34)
	btn.Position = UDim2.new(0, xPos, 0, 370)
	btn.BackgroundColor3 = idleCol
	btn.BackgroundTransparency = 0.08
	btn.TextColor3 = PALETTE.Text
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.Text = text
	btn.AutoButtonColor = false
	btn.ZIndex = 3
	btn.Parent = window
	round(btn, 9)
	stroke(btn, isPrimary and Color3.fromRGB(150, 202, 255) or PALETTE.Border, 1, 0.32)

	btn.MouseEnter:Connect(function()
		tween(btn, 0.12, { BackgroundColor3 = hoverCol })
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, 0.12, { BackgroundColor3 = idleCol })
	end)
	btn.MouseButton1Down:Connect(function()
		tween(btn, 0.08, { BackgroundColor3 = pressCol })
	end)
	btn.MouseButton1Up:Connect(function()
		tween(btn, 0.1, { BackgroundColor3 = hoverCol })
	end)
	btn.MouseButton1Click:Connect(callback)
	return btn
end

local sharedScope = setmetatable({}, { __index = getfenv and getfenv() or _G })

makeActionBtn("Execute", 18, 152, true, function()
	local src = codeBox.Text
	persistState()
	if src:match("^%s*$") then
		setStatus("Nothing to execute.", PALETTE.Error)
		return
	end
	if typeof(loadstring) ~= "function" then
		setStatus("loadstring() is not available in this context.", PALETTE.Error)
		return
	end

	local fn, syntaxErr = loadstring(src)
	if not fn then
		setStatus("Syntax error: " .. tostring(syntaxErr), PALETTE.Error)
		return
	end

	if typeof(setfenv) == "function" then
		pcall(setfenv, fn, sharedScope)
	end

	setStatus("Executing...", PALETTE.AccentHover)
	task.spawn(function()
		local ok, out = pcall(fn)
		if ok then
			setStatus("Executed cleanly" .. (out ~= nil and (" (" .. tostring(out) .. ")") or ""), PALETTE.Success)
		else
			setStatus("Runtime error: " .. tostring(out), PALETTE.Error)
		end
	end)
end)

