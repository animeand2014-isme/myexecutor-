	updateCaretVisuals()
end)

codeBox.FocusLost:Connect(function()
	tween(editorStroke, 0.14, { Color = PALETTE.Border, Transparency = 0.32 })
	tween(activeLineBar, 0.14, { BackgroundTransparency = 0.55 })
	persistState()
end)

codeBox:GetPropertyChangedSignal("CursorPosition"):Connect(updateCaretVisuals)

local function syncEditorLayout()
	local _, lineCount = codeBox.Text:gsub("\n", "\n")
	local lines = math.max(1, lineCount + 1)
	local rows = {}
	for i = 1, lines do
		rows[i] = tostring(i)
	end
	gutter.Text = table.concat(rows, "\n")

	local neededHeight = math.max(214, lines * LINE_HEIGHT + 16)
	scroller.CanvasSize = UDim2.new(0, 0, 0, neededHeight)
	gutter.Size = UDim2.new(0, 32, 0, neededHeight - 8)
	codeBox.Size = UDim2.new(1, -50, 0, neededHeight - 8)
	updateCaretVisuals()
end

-- Tab Management & Persistence
state.activeTab = math.clamp(tonumber(state.activeTab) or 1, 1, #state.tabs)
local isSyncingText = false
local renderTabs

local function switchTab(index)
	state.activeTab = math.clamp(index, 1, #state.tabs)
	isSyncingText = true
	codeBox.Text = tostring(state.tabs[state.activeTab].code or "")
	isSyncingText = false
	scroller.CanvasPosition = Vector2.new(0, 0)
	syncEditorLayout()
	persistState()
	renderTabs()
end

renderTabs = function()
	for _, child in ipairs(tabStrip:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	local totalWidth = 0
	for i, tabData in ipairs(state.tabs) do
		local active = (i == state.activeTab)
		local canClose = (#state.tabs > 1)
		local tabWidth = canClose and 106 or 88

		local tabBtn = Instance.new("TextButton")
		tabBtn.Size = UDim2.new(0, tabWidth, 0, 26)
		tabBtn.BackgroundColor3 = active and PALETTE.TabActive or PALETTE.TabIdle
		tabBtn.Text = ""
		tabBtn.AutoButtonColor = false
		tabBtn.LayoutOrder = i
		tabBtn.ZIndex = 4
		tabBtn.Parent = tabStrip
		round(tabBtn, 7)
		stroke(tabBtn, active and PALETTE.BorderGlow or PALETTE.Border, 1, active and 0.1 or 0.4)

		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, canClose and -26 or -12, 1, 0)
		lbl.Position = UDim2.new(0, 8, 0, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = tostring(tabData.name or ("Script " .. i))
		lbl.TextColor3 = active and Color3.new(1, 1, 1) or PALETTE.SubText
		lbl.Font = active and Enum.Font.GothamBold or Enum.Font.GothamSemibold
		lbl.TextSize = 11
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.TextTruncate = Enum.TextTruncate.AtEnd
		lbl.ZIndex = 5
		lbl.Parent = tabBtn

		tabBtn.MouseButton1Click:Connect(function()
			switchTab(i)
		end)

		if canClose then
			local closeTab = Instance.new("TextButton")
			closeTab.Size = UDim2.new(0, 18, 0, 18)
			closeTab.Position = UDim2.new(1, -21, 0.5, -9)
			closeTab.BackgroundTransparency = 1
			closeTab.Text = "×"
			closeTab.TextColor3 = active and Color3.new(1, 1, 1) or PALETTE.SubText
			closeTab.Font = Enum.Font.GothamBold
			closeTab.TextSize = 13
			closeTab.ZIndex = 5
			closeTab.Parent = tabBtn

			closeTab.MouseButton1Click:Connect(function()
				table.remove(state.tabs, i)
				if state.activeTab >= i then
					state.activeTab = math.max(1, state.activeTab - 1)
				end
				switchTab(state.activeTab)
			end)
		end

		totalWidth += tabWidth + 6
	end

	local addBtn = Instance.new("TextButton")
	addBtn.Size = UDim2.new(0, 28, 0, 26)
	addBtn.BackgroundColor3 = PALETTE.BtnIdle
	addBtn.Text = "+"
	addBtn.TextColor3 = PALETTE.Text
	addBtn.Font = Enum.Font.GothamBold
	addBtn.TextSize = 15
	addBtn.AutoButtonColor = false
	addBtn.LayoutOrder = #state.tabs + 1
	addBtn.ZIndex = 4
	addBtn.Parent = tabStrip
	round(addBtn, 7)
	stroke(addBtn, PALETTE.Border, 1, 0.35)

	addBtn.MouseEnter:Connect(function()
		tween(addBtn, 0.12, { BackgroundColor3 = PALETTE.BtnHover })
	end)
	addBtn.MouseLeave:Connect(function()
		tween(addBtn, 0.12, { BackgroundColor3 = PALETTE.BtnIdle })
	end)
	addBtn.MouseButton1Click:Connect(function()
		local nextNum = #state.tabs + 1
		table.insert(state.tabs, { name = "Script " .. tostring(nextNum), code = "" })
		switchTab(#state.tabs)
	end)

	totalWidth += 34
	tabStrip.CanvasSize = UDim2.new(0, totalWidth, 0, 0)
end

codeBox:GetPropertyChangedSignal("Text"):Connect(function()
	if not isSyncingText and state.tabs[state.activeTab] then
		state.tabs[state.activeTab].code = codeBox.Text
	end
	syncEditorLayout()
end)

switchTab(state.activeTab)

