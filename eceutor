local function getCaretLineAndCol()
	local pos = codeBox.CursorPosition
	if not pos or pos < 1 then
		return 1, 1
	end
	local prefix = codeBox.Text:sub(1, pos - 1)
	local _, lineBreaks = prefix:gsub("\n", "\n")
	local line = lineBreaks + 1
	local lastBreak = prefix:match(".*()\n")
	local col = lastBreak and (pos - lastBreak) or pos
	return line, math.max(1, col)
end

local function updateCaretVisuals()
	local line, col = getCaretLineAndCol()
	cursorMeta.Text = string.format("Ln %d, Col %d", line, col)

	local lineTop = 4 + (line - 1) * LINE_HEIGHT
	activeLineBar.Position = UDim2.new(0, 4, 0, lineTop)

	local linePx = (line - 1) * LINE_HEIGHT
	local viewH = scroller.AbsoluteSize.Y
	if viewH > 0 then
		if linePx < scroller.CanvasPosition.Y then
			scroller.CanvasPosition = Vector2.new(0, math.max(0, linePx - 8))
		elseif linePx + LINE_HEIGHT + 6 > scroller.CanvasPosition.Y + viewH then
			scroller.CanvasPosition = Vector2.new(0, math.max(0, linePx + LINE_HEIGHT + 6 - viewH))
		end
	end
end

