local function loadDiskState()
	if typeof(isfile) == "function" and typeof(readfile) == "function" then
		local ok, exists = pcall(isfile, SAVE_FILE)
		if ok and exists then
			local readOk, raw = pcall(readfile, SAVE_FILE)
			if readOk and type(raw) == "string" then
				local decOk, data = pcall(function()
					return HttpService:JSONDecode(raw)
				end)
				if decOk and type(data) == "table" and type(data.tabs) == "table" and #data.tabs > 0 then
					_G.AdithyaSavedState = data
				end
			end
		end
	end
end

local function persistState()
	if typeof(writefile) == "function" then
		pcall(function()
			writefile(SAVE_FILE, HttpService:JSONEncode(_G.AdithyaSavedState))
		end)
	end
end

