-- Live FPS & Ping Loop
local frameCount = 0
local elapsedAccum = 0
RunService.RenderStepped:Connect(function(dt)
	frameCount += 1
	elapsedAccum += dt
	if elapsedAccum >= 0.35 then
		local fps = math.round(frameCount / elapsedAccum)
		frameCount = 0
		elapsedAccum = 0

		fpsLabel.Text = "FPS: " .. tostring(fps)
		if fps >= 55 then
			fpsLabel.TextColor3 = PALETTE.Success
		elseif fps >= 30 then
			fpsLabel.TextColor3 = PALETTE.Warn
		else
			fpsLabel.TextColor3 = PALETTE.Error
		end

		local pingMs
		local okPing, networkPing = pcall(function()
			return player:GetNetworkPing()
		end)
		if okPing and type(networkPing) == "number" and networkPing > 0 then
			pingMs = math.round(networkPing * 1000)
		else
			local okStat, item = pcall(function()
				local perf = Stats:FindFirstChild("PerformanceStats")
				return perf and perf:FindFirstChild("Ping")
			end)
			if okStat and item and typeof(item.GetValue) == "function" then
				local okVal, val = pcall(function()
					return item:GetValue()
				end)
				if okVal and type(val) == "number" then
					pingMs = math.round(val)
				end
			end
		end

		if pingMs then
			pingLabel.Text = "Ping: " .. tostring(pingMs) .. " ms"
			if pingMs <= 90 then
				pingLabel.TextColor3 = PALETTE.Success
			elseif pingMs <= 180 then
				pingLabel.TextColor3 = PALETTE.Warn
			else
				pingLabel.TextColor3 = PALETTE.Error
			end
		else
			pingLabel.Text = "Ping: N/A"
			pingLabel.TextColor3 = PALETTE.SubText
		end
	end
end)

